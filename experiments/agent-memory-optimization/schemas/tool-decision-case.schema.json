{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proxy tool-decision evaluation case",
  "type": "object",
  "required": ["case_id", "split", "source", "template_family", "messages", "enabled_families", "expected_family", "reason"],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "split": { "enum": ["dev", "test"] },
    "source": { "enum": ["synthetic", "public-adapted", "production-anonymized"] },
    "source_id": { "type": "string" },
    "template_family": { "type": "string", "minLength": 1 },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["user", "assistant"] },
          "content": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "enabled_families": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["memory", "skill", "knowledge"] }
    },
    "expected_family": { "enum": ["memory", "skill", "knowledge", "none"] },
    "reason": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
